# Copy to `.env` for local `netlify dev`, OR set these in the Netlify dashboard
# (Site settings -> Environment variables) for production.
#
# These are read ONLY by the server-side Netlify Functions. They are never sent
# to the browser, so the API keys stay private.

# OpenAI — used by /api/transcribe (Whisper speech-to-text)
OPENAI_API_KEY=sk-...

# Google Cloud — used by /api/translate (Translation API v2, English/Arabic -> Russian)
GOOGLE_TRANSLATE_API_KEY=AIza...

# ElevenLabs — used by /api/speak (Flash v2.5 text-to-speech)
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# --- Optional overrides (sensible defaults are baked into the functions) ---
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# TARGET_LANG=ru
# WHISPER_MODEL=whisper-1
